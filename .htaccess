# Serve the Vite production build from /dist on Hostinger
DirectoryIndex dist/index.html index.html

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite requests that are already inside /dist
  RewriteRule ^dist/ - [L]

  # Force root index to the built app (avoid source index.html)
  RewriteRule ^index\.html$ dist/index.html [L]

  # Map /assets, favicon, and SPA routes into /dist
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>
