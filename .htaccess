# Hostinger serves the full Git repo from public_html.
# Public URLs stay clean at https://dhamrejini.lk/

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never show /index.html in the address bar
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Never show /dist in the address bar
  RewriteCond %{THE_REQUEST} \s/+dist/?[\s?] [NC]
  RewriteRule ^dist/?$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+dist/([^\s?]*) [NC]
  RewriteRule ^dist/(.*)$ /$1 [R=301,L]

  # Homepage
  RewriteRule ^$ dist/index.html [L]

  # Prefer production build files
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # SPA routes (about, gallery, contact, ...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>
