# Hostinger deploys the full Git repo into public_html.
# Production site is the Vite build in /dist.

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave /dist alone
  RewriteRule ^dist(/|$) - [L]

  # Send homepage (and source index) to the built app
  RewriteRule ^$ /dist/ [R=302,L]
  RewriteRule ^index\.html$ /dist/ [R=302,L]
</IfModule>
