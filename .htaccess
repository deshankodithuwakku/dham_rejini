# Hostinger serves the full Git repo from public_html.
# Keep URLs at the domain root and map them to the Vite build in /dist.

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Remove /dist from the public URL
  RewriteRule ^dist/(.*)$ /$1 [R=301,L]
  RewriteRule ^dist/?$ / [R=301,L]

  # Homepage
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # Prefer production build files
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # SPA routes (about, gallery, contact, ...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>
