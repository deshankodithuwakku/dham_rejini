# Hostinger deploys the full Git repo into public_html.
# The live site is the Vite build in /dist.

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Built app and its assets
  RewriteRule ^dist(/|$) - [L]

  # Homepage
  RewriteRule ^$ /dist/ [R=302,L]
  RewriteRule ^index\.html$ /dist/ [R=302,L]

  # Other site paths (about, gallery, contact, ...)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /dist/$1 [R=302,L]
</IfModule>
